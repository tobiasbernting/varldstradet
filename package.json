{
  "name": "lilla-garden",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "pnpm -r --parallel --stream run dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "db:up": "podman compose up -d db || docker compose up -d db",
    "godot:strings": "node --experimental-transform-types packages/godot/tools/export-strings.mts",
    "godot:data": "node --experimental-transform-types packages/godot/tools/export-data.mts",
    "godot:fixture": "node --experimental-transform-types packages/godot/tools/export-fixture.mts",
    "godot:sprites": "node packages/godot/tools/export-sprites.mts",
    "godot:bot": "node --experimental-transform-types packages/godot/tools/bot-check.mts",
    "godot:gen": "pnpm godot:strings && pnpm godot:data && pnpm godot:fixture"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
