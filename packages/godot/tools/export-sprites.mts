// Renders the game's drawn-in-code pixel art (packages/client/src/art) to PNG sprite sheets for the native client:
// the hero in each class's outfit for each skin tone (4 directions × 3 frames) and the monsters and bosses of the
// dungeons listed below (two walk frames). The art needs a canvas, so tools/sprites-page.ts is bundled with Vite
// (the client's) and run in Playwright's Chromium; the sheets and assets/sprites/atlas.json are committed.
// Run `pnpm godot:sprites` after changing the art or adding a dungeon. See ART.md, "Sprites from the browser's art".
import fs from 'node:fs';
import { createRequire } from 'node:module';
import path from 'node:path';
import { fileURLToPath } from 'node:url';

const here = path.dirname(fileURLToPath(import.meta.url));
const clientDir = path.resolve(here, '../../client');
const outDir = path.resolve(here, '../assets/sprites');
/** The dungeons whose creatures are exported (M3a: Draugkryptan). */
const DUNGEONS = (process.argv[2] ?? 'draug').split(',');

// vite comes from the client package (the godot package has no node_modules); Playwright from wherever the machine
// keeps it: its own install (`npm i -g playwright`, NODE_PATH) or PLAYWRIGHT_DIR
const clientRequire = createRequire(path.join(clientDir, 'package.json'));
const vite = (await import(clientRequire.resolve('vite'))) as typeof import('vite');
const localRequire = createRequire(import.meta.url);
const pwDir = process.env.PLAYWRIGHT_DIR;
const playwright = (pwDir ? localRequire(path.join(pwDir, 'index.js')) : localRequire('playwright')) as typeof import('playwright');

const bundle = await vite.build({
  root: clientDir,
  logLevel: 'warn',
  configFile: false,
  // the page sits outside the client package, so the workspace package is pointed at by hand
  resolve: { alias: { '@lilla-garden/shared': path.resolve(here, '../../shared/src/index.ts') } },
  build: {
    write: false,
    minify: false,
    target: 'esnext',
    lib: { entry: path.join(here, 'sprites-page.ts'), name: 'Sprites', formats: ['iife'], fileName: () => 'sprites.js' },
  },
});
const output = (Array.isArray(bundle) ? bundle[0] : bundle) as { output: { code?: string }[] };
const code = output.output.find((o) => o.code)?.code;
if (!code) throw new Error('vite produced no code');

const browser = await playwright.chromium.launch(process.env.CHROMIUM ? { executablePath: process.env.CHROMIUM } : {});
try {
  const page = await browser.newPage();
  page.on('pageerror', (e) => console.error('page error:', e));
  await page.setContent('<!doctype html><html><body></body></html>');
  await page.addScriptTag({ content: code });
  const result = (await page.evaluate((ids) => (window as unknown as { Sprites: { render: (d: string[]) => unknown } }).Sprites.render(ids), DUNGEONS)) as {
    sheets: { file: string; frame_w: number; frame_h: number; columns: number; frames: string[]; png: string }[];
    heroes: Record<string, string[]>;
    skins: string[];
    species: string[];
  };
  fs.mkdirSync(outDir, { recursive: true });
  const sheets: Record<string, { file: string; frame_w: number; frame_h: number; columns: number; frames: string[] }> = {};
  for (const s of result.sheets) {
    const prefix = 'data:image/png;base64,';
    if (!s.png.startsWith(prefix)) throw new Error(`${s.file}: not a png`);
    fs.writeFileSync(path.join(outDir, s.file), Buffer.from(s.png.slice(prefix.length), 'base64'));
    sheets[s.file.replace(/\.png$/, '')] = { file: s.file, frame_w: s.frame_w, frame_h: s.frame_h, columns: s.columns, frames: s.frames };
  }
  const atlas = {
    _comment: 'Generated by `pnpm godot:sprites` from packages/client/src/art. Do not edit; edit the art and run the script.',
    /** One sprite pixel is 1/16 of a tile (a metre in the scene). */
    pixel: 16,
    /** The hero sheets per class, in the order of `skins` (pick the nearest skin tone). */
    heroes: result.heroes,
    skins: result.skins,
    /** The creatures with a `mob_<species>` sheet. */
    species: result.species,
    sheets,
  };
  fs.writeFileSync(path.join(outDir, 'atlas.json'), JSON.stringify(atlas, null, 2) + '\n');
  console.log(`${path.relative(process.cwd(), outDir)}: ${result.sheets.length} sheets (${Object.keys(result.heroes).length} classes × ${result.skins.length} skins, ${result.species.length} creatures: ${result.species.join(', ')})`);
} finally {
  await browser.close();
}
