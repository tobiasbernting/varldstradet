// Renders the game's drawn-in-code pixel art (packages/art/src) to PNG sprite sheets for the native client:
// the hero in each class's outfit for each skin tone (4 directions × 3 frames), the monsters and bosses of the
// dungeons listed below (two walk frames), and for the farm (M4a): the character layers Godot composes (checked here
// against drawCharacter pixel for pixel), the villagers, and the pets, farm, wild and roaming animals. The art needs a canvas, so tools/sprites-page.ts is bundled with Vite
// (packages/art/vite.config.ts) and run in Playwright's Chromium; the sheets and assets/sprites/atlas.json are committed.
// Run `pnpm godot:sprites` after changing the art or adding a dungeon. See ART.md, "Sprites from the drawn-in-code art".
import fs from 'node:fs';
import { createRequire } from 'node:module';
import path from 'node:path';
import { fileURLToPath } from 'node:url';

const here = path.dirname(fileURLToPath(import.meta.url));
const artDir = path.resolve(here, '../../art');
const outDir = path.resolve(here, '../assets/sprites');
/** The dungeons whose creatures are exported (M3a: Draugkryptan). */
const DUNGEONS = (process.argv[2] ?? 'draug').split(',');

// vite comes from the art package (the godot package has no node_modules); Playwright from wherever the machine
// keeps it: its own install (`npm i -g playwright`, NODE_PATH) or PLAYWRIGHT_DIR
const artRequire = createRequire(path.join(artDir, 'package.json'));
const vite = (await import(artRequire.resolve('vite'))) as typeof import('vite');
const localRequire = createRequire(import.meta.url);
const pwDir = process.env.PLAYWRIGHT_DIR;
const playwright = (pwDir ? localRequire(path.join(pwDir, 'index.js')) : localRequire('playwright')) as typeof import('playwright');

const bundle = await vite.build({ configFile: path.join(artDir, 'vite.config.ts') });
const output = (Array.isArray(bundle) ? bundle[0] : bundle) as { output: { code?: string }[] };
const code = output.output.find((o) => o.code)?.code;
if (!code) throw new Error('vite produced no code');

const browser = await playwright.chromium.launch(process.env.CHROMIUM ? { executablePath: process.env.CHROMIUM } : {});
try {
  const page = await browser.newPage();
  page.on('pageerror', (e) => console.error('page error:', e));
  await page.setContent('<!doctype html><html><body></body></html>');
  await page.addScriptTag({ content: code });
  const result = (await page.evaluate((ids) => (window as unknown as { Sprites: { render: (d: string[]) => Promise<unknown> } }).Sprites.render(ids), DUNGEONS)) as {
    sheets: { file: string; frame_w: number; frame_h: number; columns: number; frames: string[]; headroom: number; png: string }[];
    heroes: Record<string, string[]>;
    skins: string[];
    species: string[];
    icons: Record<string, { x: number; y: number; w: number; h: number }>;
    farm: Record<string, unknown>;
    farmFiles: { file: string; png: string }[];
    farmCheck: { looks: number; frames: number; glassMaxDiff: number };
    farmAnimals: Record<string, unknown>;
    npcs: Record<string, unknown>;
  };
  const decode = (file: string, png: string): Buffer => {
    const prefix = 'data:image/png;base64,';
    if (!png.startsWith(prefix)) throw new Error(`${file}: not a png`);
    return Buffer.from(png.slice(prefix.length), 'base64');
  };
  fs.mkdirSync(outDir, { recursive: true });
  const sheets: Record<string, { file: string; frame_w: number; frame_h: number; columns: number; frames: string[]; headroom: number }> = {};
  for (const s of result.sheets) {
    fs.writeFileSync(path.join(outDir, s.file), decode(s.file, s.png));
    sheets[s.file.replace(/\.png$/, '')] = { file: s.file, frame_w: s.frame_w, frame_h: s.frame_h, columns: s.columns, frames: s.frames, headroom: s.headroom };
  }
  for (const f of result.farmFiles) fs.writeFileSync(path.join(outDir, f.file), decode(f.file, f.png));
  const atlas = {
    _comment: 'Generated by `pnpm godot:sprites` from packages/art/src. Do not edit; edit the art and run the script.',
    /** One sprite pixel is 1/16 of a tile (a metre in the scene). */
    pixel: 16,
    /** The hero sheets per class, in the order of `skins` (pick the nearest skin tone). */
    heroes: result.heroes,
    skins: result.skins,
    /** The creatures with a `mob_<species>` sheet. */
    species: result.species,
    /** Where each icon sits in icons.png: `spell_<id>`, `emote_<id>`, `item_<id>`, `ui_<name>` (M3b). */
    icons: result.icons,
    /** The farm's people (M4a): layers Godot composes at runtime; the rules are in `farm.rules` and ART.md. */
    farm: result.farm,
    /** The pets, farm animals, mounts, wild animals and roaming monsters (M4a): species -> sheets (right0, right1). */
    farm_animals: result.farmAnimals,
    /** The villagers (M4a): id -> `npc_<id>` sheet (the hero's 12 frames) and name. */
    npcs: result.npcs,
    sheets,
  };
  fs.writeFileSync(path.join(outDir, 'atlas.json'), JSON.stringify(atlas, null, 2) + '\n');
  console.log(`farm layers: ${result.farmFiles.length} files, composition matches drawCharacter on ${result.farmCheck.looks} looks (${result.farmCheck.frames} frames; the glass helmet's translucent pixels within ${result.farmCheck.glassMaxDiff} level); ${Object.keys(result.farmAnimals).length} animal species, ${Object.keys(result.npcs).length} villagers`);
  console.log(`${path.relative(process.cwd(), outDir)}: ${result.sheets.length} sheets (${Object.keys(result.heroes).length} classes × ${result.skins.length} skins, ${result.species.length} creatures: ${result.species.join(', ')}; ${Object.keys(result.icons).length} icons)`);
} finally {
  await browser.close();
}
