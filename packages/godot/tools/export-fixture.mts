// Writes packages/godot/assets/fixtures/draug.json: the messages a client gets when a hero steps into
// Draugkryptan (a `welcome`, the `changes` with the dungeon's `areaData`, and one `state`), made by the shared code
// that the server runs (generateSaga through placeIn). The native client's demo mode (`--demo` on the command line)
// plays them back without a server, which is how the Godot workflow exercises the dungeon view headless, and how
// anyone can look at the dungeon without a join code. Run `pnpm godot:fixture` after changing the dungeon plan.
import fs from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import { chooseClass, createPlayer, generateWorld, placeIn, sagaKey, type AnimalSnap, type Change, type PlayerSnap, type ServerMsg } from '../../shared/src/index.ts';

const out = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../assets/fixtures/draug.json');
const key = sagaKey('draug');

const farm = generateWorld();
const p = createPlayer(farm, 'Demo', { skin: '#f1c9a5', hair: '#5a3a1e', hairStyle: 'short' });
// a fixed id and clock, so the file only changes when the game data does
delete farm.players[p.id];
p.id = 'demo';
farm.players[p.id] = p;
p.online = true;
farm.day = 1;
farm.timeMs = 0;
const changes: Change[] = [...chooseClass(farm, p.id, 'krigare')];
const area = (() => {
  const ok = placeIn(farm, p, key, 0, 0, 'up', changes);
  if (!ok) throw new Error('could not place the demo hero in the dungeon');
  const a = farm.areas![key]!;
  // placeIn put the hero at (0,0); the arch would put them at the start room's middle
  const start = a.saga!.start;
  p.x = start.x * 16 + 8;
  p.y = start.y * 16 + 8;
  for (const c of changes) if (c.t === 'areaData' && c.world) c.world = a;
  return a;
})();

const welcome: ServerMsg = {
  t: 'welcome',
  you: p.id,
  // the farm itself is not drawn by the native client yet: only the players travel with the welcome
  world: { ...farm, terrain: [], objects: {}, occupancy: {}, crops: {}, animals: {}, drops: {}, areas: undefined, dungeon: undefined, npcs: {} },
  season: 'none',
  now: 0,
  tick: 0,
};
const players: PlayerSnap[] = [{ id: p.id, x: p.x, y: p.y, facing: p.facing, moving: false, held: null, area: key }];
const animals: AnimalSnap[] = Object.values(area.animals).map((a) => ({ id: a.id, x: a.x, y: a.y, facing: a.facing, moving: a.moving, area: key }));
const state: ServerMsg = { t: 'state', timeMs: 0, day: 1, season: 'none', players, animals, npcs: [], now: 0, saga: { [key]: { f: { [p.id]: [150, 150, 0] }, m: {} } } };

const fixture = {
  _comment: 'Generated by `pnpm godot:fixture` from the shared dungeon generator. Do not edit.',
  messages: [welcome, { t: 'changes', changes }, state],
};
fs.mkdirSync(path.dirname(out), { recursive: true });
fs.writeFileSync(out, JSON.stringify(fixture) + '\n');
console.log(`${path.relative(process.cwd(), out)}: ${Object.keys(area.objects).length} objects, ${animals.length} monsters, ${(fs.statSync(out).size / 1024).toFixed(0)} kB`);
